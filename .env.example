# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# Local: `docker compose up -d db` matches the values below.
# Neon: DATABASE_URL = pooled connection string (host contains "-pooler"),
#       DIRECT_URL   = direct (non-pooled) connection string, used by migrations.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://classsync:classsync@localhost:5432/classsync?schema=public"
DIRECT_URL="postgresql://classsync:classsync@localhost:5432/classsync?schema=public"

# ---------------------------------------------------------------------------
# Auth.js
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
# AUTH_TRUST_HOST is required when not running on Vercel (e.g. `next start`).
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST=true

# Public base URL, used in certificate verification links.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# File attachments
# STORAGE_DRIVER=local stores files under LOCAL_STORAGE_DIR (development only:
# Vercel's filesystem is not persistent). Use STORAGE_DRIVER=r2 in production.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
MAX_UPLOAD_MB=4

# Cloudflare R2 (free tier) - only needed when STORAGE_DRIVER=r2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
